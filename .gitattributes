# PDS source products are archival inputs; preserve line endings byte for byte.
data/science/meda/raw/* -text -whitespace

# Large Mars raster products are stored using Git LFS.
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.ovr filter=lfs diff=lfs merge=lfs -text

# Preserve other binary raster formats without text conversion.
*.img binary
*.IMG binary
*.jp2 binary
*.JP2 binary