# Optional when the frontend and backend are served from different origins.
# Leave blank for local development: Vite proxies /api to port 8000.
VITE_NAVIGATION_API_URL=

# Optional per-layer overrides. The default is the matching P4-served P2 GeoTIFF.
VITE_TERRAIN_DEM_URL=
VITE_TERRAIN_SLOPE_URL=
VITE_TERRAIN_ASPECT_URL=
VITE_TERRAIN_ROUGHNESS_URL=
